{
  "name": "groundside",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate && next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "spike:payouts": "tsx --env-file=.env scripts/spike-payouts.ts",
    "rules:verify": "tsx scripts/verify-rules.ts",
    "airports:build": "tsx scripts/build-airports.ts",
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "reset-demo": "tsx --env-file=.env scripts/seed.ts --reset",
    "deploy:render": "tsx --env-file=.env scripts/deploy-render.ts",
    "reset-demo:hosted": "tsx --env-file=.env scripts/deploy-render.ts --db-only --reset",
    "explain": "tsx --env-file=.env scripts/explain-passenger.ts",
    "receipts:synthetic": "tsx scripts/make-synthetic-receipts.ts",
    "weather:dates": "tsx scripts/find-weather-dates.ts",
    "weather:fetch": "tsx scripts/fetch-weather.ts",
    "eval": "tsx --env-file=.env scripts/eval.ts",
    "eval:a2": "tsx --env-file=.env scripts/eval-a2.ts",
    "eval:a3": "tsx --env-file=.env scripts/eval-a3.ts",
    "eval:a4": "tsx --env-file=.env scripts/eval-a4.ts",
    "secret-scan": "tsx scripts/secret-scan.ts",
    "smoke": "playwright test",
    "e2e": "tsx --env-file=.env scripts/e2e-flow.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ag-charts-community": "14.3.0",
    "ag-charts-react": "14.3.0",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.15",
    "lucide-react": "1.67.0",
    "metar-taf-parser": "9.1.3",
    "next": "16.4.4",
    "openai": "7.49.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true
  }
}
