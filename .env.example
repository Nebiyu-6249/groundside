# Groundside environment variables.
# Copy to .env (PowerShell: copy .env.example .env) and edit in Notepad.
# Never commit .env. Never paste these values into chat, issues or screenshots.
# Hosted demo: npm run deploy:render uses these same values plus RENDER_API_KEY; see docs/DEPLOY.md.

# --- Database (Neon, EU region) ---
# Pooled connection string (host contains "-pooler"). Used by the running app.
# Use sslmode=verify-full (Neon shows sslmode=require; pg treats both the same today and warns about require).
DATABASE_URL=
# Direct (non-pooled) connection string. Used by Prisma migrations only.
DIRECT_URL=

# --- App ---
# Base URL used to build passenger links in the simulated outbox. Local: the port npm run dev
# prints (3001 if 3000 is taken). Render: https://<service>.onrender.com
APP_BASE_URL=http://localhost:3000
# 32+ random bytes as hex. Generate in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- PayPal (SANDBOX ONLY; the app refuses to start with any other host) ---
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Sandbox app (Merchant) client ID and secret, from Apps & Credentials > Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID as above, exposed to the browser for the PayPal JS SDK on /demo/book.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# ID of the sandbox webhook that points at THIS environment (local tunnel or Render).
PAYPAL_WEBHOOK_ID=
# Optional: the business account's EUR balance, read from the sandbox dashboard. The balance API
# returns 403 in sandbox, so the Readiness panel uses this estimate when set (and today's cap always).
SANDBOX_BALANCE_ESTIMATE_EUR=
# Comma-separated sandbox PERSONAL account emails used as the demo receiver pool (10 accounts).
PAYPAL_POOL_RECEIVERS=
# Email pattern proven in Phase 0 to produce UNCLAIMED payouts; {n} is replaced by a number.
PAYPAL_UNREGISTERED_PATTERN=pax-{n}@example.com
# Safety cap on total payouts per day (from 00:00 UTC), in EUR, PayPal fees not counted. One full
# judge walkthrough (scenario A then B) sent about 5,830 EUR on 2026-11-06, so 12000 allows two a
# day (owner decision 2026-11-06). Approvals costing more than this need the cost typed.
PAYOUT_DAILY_CAP_EUR=12000
# Items per payout micro-batch.
PAYOUT_BATCH_SIZE=20

# --- OpenAI ---
OPENAI_API_KEY=
# Model IDs are chosen from env, never hardcoded. Development uses the cheapest
# current model with structured outputs and image input (gpt-6-luna) for all three.
# Planned for the hosted demo, to be confirmed by the Phase 2 evals:
#   OPENAI_MODEL_ASSESS=gpt-6.1-sol   (A1 cause assessment, reasoning)
#   OPENAI_MODEL_VISION=gpt-6.1-terra (A2 receipt reading)
#   OPENAI_MODEL_TEXT=gpt-6-luna      (A3 notices, A4 questions)
OPENAI_MODEL_ASSESS=gpt-6-luna
OPENAI_MODEL_VISION=gpt-6-luna
OPENAI_MODEL_TEXT=gpt-6-luna
# live = call OpenAI; fixtures = serve recorded, labelled results only.
AI_MODE=live
# Daily AI spend cap in USD; when reached, recorded fixtures are served.
AI_DAILY_BUDGET_USD=3

# --- Judge mode and demo accounts ---
# true on the hosted app.
JUDGE_MODE=false
# Judge demo runs allowed per hour per (hashed) IP.
MAX_JUDGE_RUNS_PER_HOUR=5
# Owner login (full runs, settings), created by the seed script.
OWNER_EMAIL=
OWNER_PASSWORD=
# Judge-facing duty manager login, created by the seed script and published in the README.
# Default email duty.manager@demo.groundside.test. If DEMO_OPS_PASSWORD is empty, the seed
# generates one and writes it to scripts/out/demo-credentials.txt (git-ignored).
DEMO_OPS_EMAIL=
DEMO_OPS_PASSWORD=

# --- Published demo logins (npm run publish-logins) ---
# Optional: the PayPal sandbox buyer account judges use on /demo/book. Sandbox only; the script
# writes it into README.md and docs/DEVPOST_DRAFT.md on purpose. Use a buyer account that is not
# one of PAYPAL_POOL_RECEIVERS.
SANDBOX_BUYER_EMAIL=
SANDBOX_BUYER_PASSWORD=

# --- Render (npm run deploy:render) ---
# API key from Render > Account Settings > API Keys. Used only by the deploy script, never by the app.
RENDER_API_KEY=
# Optional: the Render workspace ID. Empty uses the first workspace the key can see.
RENDER_OWNER_ID=
